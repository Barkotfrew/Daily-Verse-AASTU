# Create a local .env file and add your Telegram bot token from BotFather.
BOT_TOKEN=replace_with_your_telegram_bot_token

# SQLite database file (relative paths are relative to the project directory).
DATABASE_PATH=data/daily_verse.sqlite3

# Set after the GitHub Pages site is published (see README).
MINI_APP_URL=

# Keep false until the deployed scheduler and persistent database are verified.
REMINDER_SCHEDULER_ENABLED=false

# Reminder time in East Africa Time (24-hour HH:MM). Normal default is 07:00.
REMINDER_TIME=07:00

# Keep false until the deployed scheduler and persistent database are verified.
REMINDER_SCHEDULER_ENABLED=false
